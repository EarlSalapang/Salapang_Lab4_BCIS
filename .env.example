# Local development only. Copy this file to .env and set values for your environment.
DATABASE_URL=postgresql://bcis:change-me@localhost:5432/bcis
API_HOST=127.0.0.1
API_PORT=3000
BCIS_API_URL=http://127.0.0.1:3000

# Logging. LOG_LEVEL is one of fatal, error, warn, info, debug, trace, silent.
# Set LOG_FILE to also write structured JSON logs to a rotating path on the server.
LOG_LEVEL=info
# LOG_FILE=C:\bcis\logs\api.log

# Database maintenance. BACKUP_DIR is where db:backup writes archives and checksums.
# BACKUP_DIR=C:\bcis\backups
# Set BCIS_CONFIRM_RESTORE=yes only for the moment you intend to run db:restore.
# BCIS_CONFIRM_RESTORE=yes

# Required bootstrap values: set once to create the initial admin, then remove.
BCIS_INITIAL_ADMIN_USERNAME=
BCIS_INITIAL_ADMIN_PASSWORD=

# Required for LAN exposure. Keep certificate/private key outside source control.
# API_TLS_CERT_FILE=C:\secure\bcis-api.crt
# API_TLS_KEY_FILE=C:\secure\bcis-api.key

# Used by the local PostgreSQL container. Set a non-default password in .env.
POSTGRES_USER=bcis
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bcis
