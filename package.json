{
  "name": "bcis-subscription-billing-system",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "workspaces": [
    "packages/shared",
    "apps/api",
    "apps/desktop"
  ],
  "scripts": {
    "dev": "concurrently -k -n API,DESKTOP -c blue,green \"npm:dev:api\" \"npm:dev:desktop\"",
    "dev:api": "npm run dev --workspace @bcis/api",
    "dev:desktop": "npm run dev --workspace @bcis/desktop",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace @bcis/api",
    "db:migrate": "npm run db:migrate --workspace @bcis/api",
    "db:seed-admin": "npm run db:seed-admin --workspace @bcis/api"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "concurrently": "^10.0.5",
    "eslint": "^9.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0"
  },
  "overrides": {
    "esbuild": "^0.25.4",
    "shell-quote": "^1.11.0"
  }
}
