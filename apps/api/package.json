{
  "name": "@bcis/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run src",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts",
    "db:seed-admin": "tsx src/seed-admin.ts",
    "db:seed-demo": "tsx src/seed-demo.ts",
    "db:integrity": "tsx src/integrity.ts",
    "db:backup": "tsx src/backup.ts",
    "db:restore": "tsx src/restore.ts"
  },
  "dependencies": {
    "dotenv": "^16.0.0",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.0.0",
    "pg": "^8.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.0.0",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.0.0",
    "vitest": "^5.0.3"
  }
}
